# Babel Environment Configuration Example
# Copy this file to .env and adjust the values

# Server Port
BABEL_PORT=8765

# Timezone (e.g., UTC, Europe/Stockholm, America/New_York)
TZ=UTC

# Auth (Basic Auth for UI)
BABEL_AUTH_USERNAME=
BABEL_AUTH_PASSWORD=

# Webhook Secret (Requires requests to include ?secret=your_secret_here)
BABEL_WEBHOOK_SECRET=

# Media Paths inside the container
TV_PATH=/media/tv
MOVIES_PATH=/media/movies
