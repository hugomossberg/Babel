# ==============================================================================
# Babel Environment Configuration (Optional)
# ==============================================================================
# Most settings (AI providers, API keys, languages, integrations) are configured
# directly through the web UI at http://SERVER-IP:8765.
#
# A .env file is OPTIONAL. Use it only if you want to customize host paths,
# ports, or container-level authentication.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Media Paths (Host Directory Mounts)
# ------------------------------------------------------------------------------
# Host directories containing your media libraries mounted into the container.
TV_PATH=/path/to/tv
MOVIES_PATH=/path/to/movies

# ------------------------------------------------------------------------------
# 2. General Settings
# ------------------------------------------------------------------------------
# Host port Babel listens on (default: 8765)
BABEL_PORT=8765

# Container timezone for logs and background tasks (default: UTC)
TZ=UTC

# ------------------------------------------------------------------------------
# 3. Advanced / Optional Security
# ------------------------------------------------------------------------------
# Basic HTTP Authentication for the web dashboard (leave empty to disable)
BABEL_AUTH_USERNAME=
BABEL_AUTH_PASSWORD=

# Webhook Secret for Sonarr/Radarr webhooks (leave empty to disable)
# When set, webhooks must provide ?secret=YOUR_SECRET or header X-Webhook-Secret
BABEL_WEBHOOK_SECRET=
